generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// SALONFLOW OS - Enterprise Salon & Spa DB
// ============================================

// Multi-Branch / Workspace
model Branch {
  id          String   @id @default(cuid())
  name        String
  address     String?
  phone       String?
  email       String?
  isActive    Boolean  @default(true)
  branchCode  String   @unique
  timezone    String   @default("Asia/Karachi")
  openTime    String   @default("09:00")
  closeTime   String   @default("21:00")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff       Staff[]
  appointments Appointment[]
  rooms       Room[]
  inventoryItems InventoryItem[]
  invoices    Invoice[]
  expenses    Expense[]
  shifts      Shift[]
  marketingCampaigns MarketingCampaign[]
}

// Staff / Employees
model Staff {
  id            String   @id @default(cuid())
  branchId      String
  firstName     String
  lastName      String
  email         String   @unique
  phone         String?
  role          String   @default("stylist") // owner, manager, receptionist, stylist, beautician, therapist
  specialization String?
  hireDate      DateTime @default(now())
  status        String   @default("active") // active, inactive, on_leave
  commissionRate Float   @default(0.10)
  avatar        String?
  bio           String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch        Branch   @relation(fields: [branchId], references: [id])
  appointments  Appointment[]
  shifts        Shift[]
  commissions   Commission[]
  attendanceRecords Attendance[]

  @@index([branchId])
}

// Attendance
model Attendance {
  id        String   @id @default(cuid())
  staffId   String
  branchId  String
  date      DateTime
  clockIn   DateTime?
  clockOut  DateTime?
  status    String   @default("present") // present, absent, late, half_day
  notes     String?
  createdAt DateTime @default(now())

  staff     Staff    @relation(fields: [staffId], references: [id])

  @@index([staffId, date])
}

// Shifts
model Shift {
  id        String   @id @default(cuid())
  staffId   String
  branchId  String
  date      DateTime
  startTime String
  endTime   String
  status    String   @default("scheduled") // scheduled, completed, cancelled
  createdAt DateTime @default(now())

  staff     Staff    @relation(fields: [staffId], references: [id])
  branch    Branch   @relation(fields: [branchId], references: [id])

  @@index([staffId, date])
}

// Customers
model Customer {
  id            String   @id @default(cuid())
  firstName     String
  lastName      String
  email         String?
  phone         String
  gender        String?
  dateOfBirth   DateTime?
  address       String?
  city          String?
  notes         String?
  skinType      String?
  hairType      String?
  preferences   String?
  loyaltyTier   String   @default("silver") // silver, gold, platinum, vip
  loyaltyPoints Int      @default(0)
  totalVisits   Int      @default(0)
  lifetimeValue Float    @default(0)
  referredBy    String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  appointments  Appointment[]
  invoices      Invoice[]
  memberships   Membership[]
  loyaltyTransactions LoyaltyTransaction[]
  customerDocuments CustomerDocument[]

  @@index([phone])
  @@index([email])
}

// Customer Documents / Photos
model CustomerDocument {
  id          String   @id @default(cuid())
  customerId  String
  type        String   // before_photo, after_photo, prescription, notes, other
  title       String
  fileUrl     String
  notes       String?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

// Service Categories
model ServiceCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  services    Service[]

  @@index([sortOrder])
}

// Services
model Service {
  id            String   @id @default(cuid())
  categoryId    String
  name          String
  description   String?
  duration      Int      // minutes
  price         Float
  isActive      Boolean  @default(true)
  isPackage     Boolean  @default(false)
  requirements  String?
  afterCare     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      ServiceCategory @relation(fields: [categoryId], references: [id])
  appointments  AppointmentService[]
  serviceAddons ServiceAddon[]

  @@index([categoryId])
}

// Service Add-ons
model ServiceAddon {
  id          String   @id @default(cuid())
  serviceId   String
  name        String
  price       Float
  duration    Int      // minutes
  isActive    Boolean  @default(true)

  service     Service  @relation(fields: [serviceId], references: [id])

  @@index([serviceId])
}

// Rooms
model Room {
  id            String   @id @default(cuid())
  branchId      String
  name          String
  roomType      String   @default("treatment") // treatment, consultation, waiting, spa
  capacity      Int      @default(1)
  status        String   @default("available") // available, occupied, cleaning, maintenance
  equipment     String?
  createdAt     DateTime @default(now())

  branch        Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
}

// Appointments
model Appointment {
  id            String   @id @default(cuid())
  branchId      String
  customerId    String
  staffId       String
  date          DateTime
  startTime     String
  endTime       String
  status        String   @default("scheduled") // scheduled, confirmed, in_progress, completed, cancelled, no_show
  type          String   @default("booking") // booking, walk_in
  notes         String?
  totalAmount   Float    @default(0)
  isRecurring   Boolean  @default(false)
  recurringId   String?
  reminderSent  Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch        Branch   @relation(fields: [branchId], references: [id])
  customer      Customer @relation(fields: [customerId], references: [id])
  staff         Staff    @relation(fields: [staffId], references: [id])
  services      AppointmentService[]

  @@index([branchId, date])
  @@index([customerId])
  @@index([staffId, date])
}

// Appointment-Services junction
model AppointmentService {
  id            String   @id @default(cuid())
  appointmentId String
  serviceId     String
  staffId       String?
  price         Float
  duration      Int
  status        String   @default("pending") // pending, in_progress, completed

  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  service       Service    @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
  @@index([serviceId])
}

// Membership Plans
model MembershipPlan {
  id            String   @id @default(cuid())
  name          String
  description   String?
  price         Float
  duration      Int      // months
  discount      Float    @default(0) // percentage
  freeServices  Int      @default(0)
  priorityBooking Boolean @default(false)
  loyaltyBonus  Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  memberships   Membership[]

  @@index([isActive])
}

// Memberships (customer subscriptions)
model Membership {
  id            String   @id @default(cuid())
  customerId    String
  planId        String
  startDate     DateTime
  endDate       DateTime
  status        String   @default("active") // active, expired, cancelled, paused
  autoRenew     Boolean  @default(true)
  paymentMethod String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  plan          MembershipPlan @relation(fields: [planId], references: [id])

  @@index([customerId])
  @@index([status])
}

// Loyalty Transactions
model LoyaltyTransaction {
  id          String   @id @default(cuid())
  customerId  String
  type        String   // earn, redeem, bonus, referral, birthday
  points      Int
  description String?
  referenceId String?
  createdAt   DateTime @default(now())

  customer    Customer @relation(fields: [customerId], references: [id])

  @@index([customerId])
}

// Product Categories
model ProductCategory {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())

  products    Product[]

  @@index([name])
}

// Products
model Product {
  id            String   @id @default(cuid())
  categoryId    String
  name          String
  description   String?
  sku           String   @unique
  brand         String?
  costPrice     Float
  sellingPrice  Float
  unit          String   @default("piece")
  reorderLevel  Int      @default(10)
  isActive      Boolean  @default(true)
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category      ProductCategory @relation(fields: [categoryId], references: [id])
  inventoryItems InventoryItem[]


  @@index([categoryId])
  @@index([sku])
}

// Inventory Items (per branch)
model InventoryItem {
  id            String   @id @default(cuid())
  productId     String
  branchId      String
  quantity      Int      @default(0)
  batchNumber   String?
  expiryDate    DateTime?
  lastRestocked DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  product       Product  @relation(fields: [productId], references: [id])
  branch        Branch   @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([productId])
}

// Invoices
model Invoice {
  id              String   @id @default(cuid())
  branchId        String
  customerId      String?
  invoiceNumber   String   @unique
  type            String   @default("service") // service, product, combo
  subtotal        Float
  tax             Float    @default(0)
  discount        Float    @default(0)
  totalAmount     Float
  paymentMethod   String   @default("cash") // cash, card, wallet, split
  paymentStatus   String   @default("paid") // paid, pending, partial, refunded
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch          Branch   @relation(fields: [branchId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])
  items           InvoiceItem[]

  @@index([branchId, createdAt])
  @@index([customerId])
}

// Invoice Items
model InvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  itemType    String   // service, product, membership, package
  itemId      String?
  name        String
  quantity    Int      @default(1)
  unitPrice   Float
  discount    Float    @default(0)
  total       Float
  staffId     String?

  invoice     Invoice  @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

// Expenses
model Expense {
  id          String   @id @default(cuid())
  branchId    String
  category    String   // rent, utilities, supplies, payroll, maintenance, marketing, other
  amount      Float
  description String?
  date        DateTime
  paidBy      String?
  receipt     String?
  createdAt   DateTime @default(now())

  branch      Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId, date])
  @@index([category])
}

// Commissions
model Commission {
  id          String   @id @default(cuid())
  staffId     String
  appointmentId String?
  amount      Float
  type        String   // service, product, referral
  status      String   @default("pending") // pending, paid
  period      String   // "2024-01"
  createdAt   DateTime @default(now())

  staff       Staff    @relation(fields: [staffId], references: [id])

  @@index([staffId])
  @@index([period])
}

// Marketing Campaigns
model MarketingCampaign {
  id          String   @id @default(cuid())
  branchId    String
  name        String
  type        String   // sms, email, whatsapp, social
  channel     String   // sms, email, whatsapp, push
  subject     String?
  content     String
  targetAudience String? // all, members, new_customers, inactive, birthday_month
  status      String   @default("draft") // draft, scheduled, sent, completed
  scheduledAt DateTime?
  sentAt      DateTime?
  recipientCount Int   @default(0)
  openRate    Float    @default(0)
  clickRate   Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch      Branch   @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([status])
}

// Audit Log
model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// Waitlist
model Waitlist {
  id          String   @id @default(cuid())
  branchId    String
  customerId  String
  serviceId   String?
  preferredDate DateTime
  preferredTime String?
  status      String   @default("waiting") // waiting, notified, booked, cancelled
  notes       String?
  createdAt   DateTime @default(now())

  @@index([branchId, status])
}

// Gift Cards
model GiftCard {
  id            String   @id @default(cuid())
  code          String   @unique
  initialBalance Float
  remainingBalance Float
  purchasedBy   String?  // customerId
  recipientName String?
  recipientEmail String?
  recipientPhone String?
  message       String?
  status        String   @default("active") // active, redeemed, expired, cancelled
  purchasedAt   DateTime @default(now())
  expiresAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  transactions GiftCardTransaction[]

  @@index([code])
  @@index([status])
}

// Gift Card Transactions
model GiftCardTransaction {
  id          String   @id @default(cuid())
  giftCardId  String
  type        String   // purchase, redeem, topup, refund
  amount      Float
  invoiceId   String?
  description String?
  createdAt   DateTime @default(now())

  giftCard    GiftCard @relation(fields: [giftCardId], references: [id])

  @@index([giftCardId])
}

// Tips / Gratuity
model Tip {
  id            String   @id @default(cuid())
  invoiceId     String?
  staffId       String
  customerId    String?
  amount        Float
  paymentMethod String   @default("cash") // cash, card, wallet
  status        String   @default("pending") // pending, paid
  createdAt     DateTime @default(now())

  @@index([staffId])
  @@index([invoiceId])
}

// Customer Feedback / Reviews
model Feedback {
  id            String   @id @default(cuid())
  customerId    String
  appointmentId String?
  staffId       String?
  rating        Int      // 1-5
  comment       String?
  tags          String?  // comma-separated: friendly,clean,professional
  status        String   @default("published") // published, hidden, flagged
  response      String?  // salon response
  respondedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([customerId])
  @@index([staffId])
  @@index([rating])
}

// Notifications
model Notification {
  id          String   @id @default(cuid())
  type        String   // appointment, payment, inventory, system, marketing
  title       String
  message     String
  category    String   @default("info") // info, warning, error, success
  isRead      Boolean  @default(false)
  actionUrl   String?
  metadata    String?  // JSON string for extra data
  createdAt   DateTime @default(now())

  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

// Salon Settings (persisted config)
model SalonSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   // JSON string
  category    String   // general, business, notifications, security, integrations
  updatedAt   DateTime @updatedAt

  @@index([category])
  @@index([key])
}

// ============================================
// OWNER MODULE - SaaS Client Management
// ============================================

// ERP Clients (salon businesses that purchase this software)
model OwnerClient {
  id              String   @id @default(cuid())
  companyName     String
  slug            String   @unique
  contactPerson   String
  email           String   @unique
  phone           String
  address         String?
  city            String?
  state           String?
  country         String   @default("Pakistan")
  postalCode      String?
  website         String?
  logoUrl         String?
  industry        String   @default("Beauty & Salon")
  businessType    String?  // salon, spa, barbershop, nail_studio, wellness_center, multi_chain
  taxId           String?  // National Tax Number / CNIC
  registrationNo  String?

  // Purchase & Billing
  purchaseType    String   @default("subscription") // subscription, one_time
  status          String   @default("active") // active, suspended, cancelled, trial
  planName        String?  // Starter, Professional, Enterprise
  billingCycle    String?  // monthly, quarterly, semi_annual, annual
  currency        String   @default("PKR")

  // Tenant Database
  tenantDbPath    String?  // Path to tenant's SQLite database
  tenantDbStatus  String   @default("pending") // pending, creating, active, error

  // Timestamps
  onboardedAt     DateTime @default(now())
  lastActiveAt    DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  modules         OwnerClientModule[]
  serialKeys      SerialKey[]
  invoices        OwnerInvoice[]
  quotations      OwnerQuotation[]
  subscriptions   OwnerClientSubscription[]
  users           OwnerClientUser[]
  tenantDatabases TenantDatabase[]

  @@index([status])
  @@index([purchaseType])
  @@index([email])
}

// Module Access per Client
model OwnerClientModule {
  id          String   @id @default(cuid())
  clientId    String
  moduleKey   String   // dashboard, appointments, customers, etc.
  moduleName  String   // Display name
  isActive    Boolean  @default(true)
  includedAt  DateTime @default(now())

  client      OwnerClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, moduleKey])
  @@index([clientId])
}

// Serial Keys / License Keys
model SerialKey {
  id          String   @id @default(cuid())
  clientId    String?
  key         String   @unique
  type        String   @default("subscription") // subscription, one_time, trial, addon
  status      String   @default("available") // available, assigned, activated, expired, revoked
  maxDevices  Int      @default(1)
  activeDevices Int    @default(0)
  validFrom   DateTime?
  validUntil  DateTime?
  activatedAt DateTime?
  revokedAt   DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      OwnerClient? @relation(fields: [clientId], references: [id])

  @@index([key])
  @@index([status])
  @@index([clientId])
}

// Owner Invoices (sent to ERP clients)
model OwnerInvoice {
  id              String   @id @default(cuid())
  clientId        String
  invoiceNumber   String   @unique
  issueDate       DateTime @default(now())
  dueDate         DateTime
  subtotal        Float
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  discountRate    Float    @default(0)
  discountAmount  Float    @default(0)
  totalAmount     Float
  paidAmount      Float    @default(0)
  currency        String   @default("PKR")
  paymentStatus   String   @default("unpaid") // unpaid, partial, paid, overdue, cancelled
  paymentMethod   String?  // bank_transfer, cheque, online, cash
  paymentRef      String?
  paidAt          DateTime?
  notes           String?
  terms           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          OwnerClient @relation(fields: [clientId], references: [id])
  items           OwnerInvoiceItem[]

  @@index([clientId])
  @@index([paymentStatus])
  @@index([invoiceNumber])
}

// Owner Invoice Items
model OwnerInvoiceItem {
  id          String   @id @default(cuid())
  invoiceId   String
  itemType    String   // subscription, module, setup_fee, customization, support, training, other
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  discount    Float    @default(0)
  total       Float

  invoice     OwnerInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

// Owner Quotations (sent to ERP clients)
model OwnerQuotation {
  id              String   @id @default(cuid())
  clientId        String
  quotationNumber String   @unique
  subject         String?
  issueDate       DateTime @default(now())
  validUntil      DateTime
  subtotal        Float
  taxRate         Float    @default(0)
  taxAmount       Float    @default(0)
  discountRate    Float    @default(0)
  discountAmount  Float    @default(0)
  totalAmount     Float
  currency        String   @default("PKR")
  status          String   @default("draft") // draft, sent, viewed, accepted, rejected, expired, converted
  notes           String?
  terms           String?
  internalNotes   String?
  convertedInvoiceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  client          OwnerClient @relation(fields: [clientId], references: [id])
  items           OwnerQuotationItem[]

  @@index([clientId])
  @@index([status])
  @@index([quotationNumber])
}

// Owner Quotation Items
model OwnerQuotationItem {
  id          String   @id @default(cuid())
  quotationId String
  itemType    String   // subscription, module, setup_fee, customization, support, training, other
  description String
  quantity    Int      @default(1)
  unitPrice   Float
  discount    Float    @default(0)
  total       Float

  quotation   OwnerQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

// Client Subscriptions
model OwnerClientSubscription {
  id            String   @id @default(cuid())
  clientId      String
  planName      String
  price         Float
  billingCycle  String   // monthly, quarterly, semi_annual, annual
  startDate     DateTime
  endDate       DateTime
  status        String   @default("active") // active, expired, cancelled, paused, trial
  autoRenew     Boolean  @default(true)
  nextBillingDate DateTime?
  cancelledAt   DateTime?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  client        OwnerClient @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([status])
}

// Client Users (admin users for each client)
model OwnerClientUser {
  id          String   @id @default(cuid())
  clientId    String
  name        String
  email       String
  phone       String?
  role        String   @default("admin") // admin, manager, viewer
  password    String?  // Hashed password
  status      String   @default("active") // active, inactive, locked
  lastLoginAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      OwnerClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, email])
  @@index([clientId])
  @@index([email])
}

// System Users (for login authentication)
model SystemUser {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String    // bcrypt hashed
  name          String
  role          String    @default("admin") // admin, manager, staff, viewer
  avatar        String?
  phone         String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  lastLoginIp   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions      UserSession[]
  activations  DeviceActivation[]

  @@index([email])
  @@index([role])
}

// User Sessions
model UserSession {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  deviceInfo  String?  // browser/device info
  ipAddress   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  user        SystemUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

// Device Activation (serial key binding)
model DeviceActivation {
  id            String   @id @default(cuid())
  deviceId      String   @unique // browser fingerprint
  serialKey     String
  deviceName    String?
  browserInfo   String?
  ipAddress     String?
  activatedBy   String?  // userId
  status        String   @default("active") // active, revoked, expired
  activatedAt   DateTime @default(now())
  revokedAt     DateTime?
  expiresAt     DateTime?

  user          SystemUser? @relation(fields: [activatedBy], references: [id])

  @@index([deviceId])
  @@index([serialKey])
  @@index([status])
}

// Tenant Databases
model TenantDatabase {
  id          String   @id @default(cuid())
  clientId    String
  dbPath      String
  dbSize      Float    @default(0) // in MB
  status      String   @default("pending") // pending, creating, active, migrating, error
  schemaVersion String @default("1.0")
  lastMigrated DateTime?
  errorLog    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  client      OwnerClient @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@index([status])
}
